# Copia este archivo a .env y completa los valores reales.
# .env NUNCA debe subirse al repositorio.

# ─── Base de datos ────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=cambia_esta_clave
MYSQL_DATABASE=desperdicio

# URL que usa SQLModel/SQLAlchemy (apunta al servicio "db" de Docker Compose)
# La contraseña debe ser IGUAL a MYSQL_ROOT_PASSWORD
DATABASE_URL=mysql+pymysql://root:cambia_esta_clave@db:3306/desperdicio

# ─── Aplicación ───────────────────────────────────────────────────────────────
PORT=8000
